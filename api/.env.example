# Local dev default matches docker-compose.yml's db service.
# In production this points at Supabase's Postgres connection string.
DATABASE_URL=postgresql+asyncpg://meridian:meridian@localhost:5432/meridian

# Supabase Auth — verifies bearer tokens server-side. Local-only dev:
# leave both unset and the API accepts the single stub user (app/deps.py).
# Never leave unset in a deployed environment.
#
# SUPABASE_JWT_SECRET: legacy HS256 shared secret (older projects only).
# SUPABASE_URL: required for current-default projects, which sign session
#   tokens asymmetrically (ES256/RS256) and are verified via
#   <SUPABASE_URL>/auth/v1/.well-known/jwks.json. Check which applies at
#   Project Settings -> API -> JWT Settings.
SUPABASE_JWT_SECRET=
SUPABASE_URL=

# Server-side only. Never referenced by anything under web/.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DAILY_TOKEN_BUDGET=200000

# Prayer-time calculation anchor (section 2.5 / 6.1 of the design doc).
LATITUDE=33.6844
LONGITUDE=73.0479
TIMEZONE=Asia/Karachi

CORS_ORIGINS=http://localhost:3000
