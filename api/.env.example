# Local dev default matches docker-compose.yml's db service.
# In production this points at Supabase's Postgres connection string.
DATABASE_URL=postgresql+asyncpg://meridian:meridian@localhost:5432/meridian

# Supabase Auth JWT secret — verifies bearer tokens server-side.
# Local-only dev: leave unset and the API accepts the single stub user
# (see app/deps.py). Never leave unset in a deployed environment.
SUPABASE_JWT_SECRET=

# Server-side only. Never referenced by anything under web/.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DAILY_TOKEN_BUDGET=200000

# Prayer-time calculation anchor (section 2.5 / 6.1 of the design doc).
LATITUDE=33.6844
LONGITUDE=73.0479
TIMEZONE=Asia/Karachi

CORS_ORIGINS=http://localhost:3000
